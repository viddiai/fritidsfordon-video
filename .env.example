# --- Databas ---
# Supabase: Project Settings -> Database -> Connection string (URI, "Session pooler").
# Lämnas tom = inbyggd lokal Postgres (PGlite) i .data/pglite – bra för test.
DATABASE_URL=

# --- Claude (manus + bildval) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- ElevenLabs (speakerröst) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=4xkUqaR9MYOJHoaC1Nak
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Granskningsvy ---
PORT=3000
ADMIN_USER=admin
ADMIN_PASSWORD=
# Publik bas-URL till granskningsvyn (används i API-svar med videolänkar)
PUBLIC_BASE_URL=http://localhost:3000

# --- Flöde ---
# Cron-uttryck för koll efter nya annonser (svensk tid)
SYNC_CRON=*/30 * * * *
# true = videor godkänns automatiskt efter rendering (när manuell granskning inte längre behövs)
AUTO_APPROVE=false
# Hur många av de nyaste fordonen som får video direkt vid allra första synken (resten kan köas från vyn)
BACKFILL_LIMIT=10
# Fordon som försvinner från sajten räknas som sålda och får en Såld-version
SOLD_ON_DISAPPEAR=true

# --- Rendering ---
STORAGE_DIR=storage
RENDER_CONCURRENCY=
# Sökväg till Chrome headless shell om Remotion inte kan ladda ner sin egen
REMOTION_BROWSER_EXECUTABLE=
